{
  "name": "@kburson/ai-peer-review",
  "version": "0.4.1",
  "description": "A deterministic, provider-neutral peer review protocol for AI agents",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ai-peer-review": "./bin/peer-review.mjs",
    "peer-review": "./bin/peer-review.mjs",
    "peer-review-codex-hook": "./bin/peer-review-codex-hook.mjs",
    "peer-review-claude-hook": "./bin/peer-review-claude-hook.mjs",
    "peer-review-mcp": "./bin/peer-review-mcp.mjs",
    "peer-review-verify-deployment": "./bin/verify-deployment.mjs"
  },
  "exports": "./src/public-api.mjs",
  "files": [
    "bin/",
    "src/",
    "schemas/",
    "templates/",
    "skills/",
    "provenance/",
    "native/broker-security/binding.gyp",
    "native/broker-security/addon.cc",
    "native/broker-security/posix.cc",
    "native/broker-security/windows.cc",
    "scripts/build-broker-security.mjs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs/releases/",
    "docs/dependency-audit-mcp.md",
    "docs/dependency-audit-broker-build.md",
    "docs/manual-cross-provider-peer-review.md",
    "docs/claude-launch-api-migration.md",
    "docs/spdx-policy.md",
    "docs/installation-runtime.md"
  ],
  "scripts": {
    "build:broker-security": "node scripts/build-broker-security.mjs",
    "pretarball:install": "npm uninstall -D @kburson/ai-task-manager",
    "tarball:install": "npm install -D file:vendors/kburson-ai-task-manager-0.1.0.tgz",
    "test": "npm run test:unit && npm run test:golden",
    "test:unit": "node test/helpers/run-suite.mjs unit",
    "test:golden": "node test/helpers/run-suite.mjs golden",
    "test:integration": "node test/helpers/run-suite.mjs integration",
    "test:packaging": "node test/helpers/run-suite.mjs packaging",
    "test:live:broker-handoff": "node -e \"console.log('Broker verification paused for #102/#107')\"",
    "test:smoke": "node test/helpers/run-suite.mjs smoke",
    "test:mcp": "node test/helpers/run-suite.mjs mcp",
    "test:slow": "npm run test:integration && npm run test:mcp && npm run test:smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && markdownlint-cli2 \"**/*.md\" && cspell --no-progress \"**/*.{md,mjs,js,json}\"",
    "pack:runtime": "node scripts/pack-runtime.mjs",
    "prepack": "node scripts/refuse-source-pack.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "jsonc-parser": "3.3.1",
    "markdownlint-cli2": "0.23.3",
    "node-gyp": "12.4.0",
    "prettier": "3.8.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@kburson/ai-task-manager": "file:vendors/kburson-ai-task-manager-0.1.0.tgz",
    "cspell": "8.19.4",
    "eslint": "9.39.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kburson/ai-peer-review.git"
  },
  "bugs": {
    "url": "https://github.com/kburson/ai-peer-review/issues"
  },
  "homepage": "https://github.com/kburson/ai-peer-review#readme"
}
