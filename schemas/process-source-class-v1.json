{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-peer-review.process-source-class/v1",
  "title": "Finite reviewed process-source class",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "classId",
    "capability",
    "scope",
    "contractDigest",
    "semantics",
    "precision",
    "acceptance",
    "approvalDigest"
  ],
  "properties": {
    "schema": {
      "const": "ai-peer-review.process-source-class/v1"
    },
    "classId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
    },
    "capability": {
      "enum": ["absence", "creation"]
    },
    "contractDigest": {
      "$ref": "#/$defs/digest"
    },
    "approvalDigest": {
      "$ref": "#/$defs/digest"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "builds", "architectures", "nodeMajors", "probe"],
      "properties": {
        "platform": {
          "enum": ["linux", "darwin", "win32"]
        },
        "builds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "enum": ["x64", "arm64"]
          }
        },
        "nodeMajors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 24,
            "maximum": 128
          }
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "version", "visibility", "errorContract"],
          "properties": {
            "path": {
              "enum": [
                "/proc",
                "/bin/ps",
                "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
              ]
            },
            "version": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            "visibility": {
              "enum": ["full-pid-namespace", "same-user-full-selection", "local-cim-query"]
            },
            "errorContract": {
              "enum": ["exact-pid-directory-v1", "exact-ps-selection-v1", "completed-cim-query-v1"]
            }
          }
        }
      }
    },
    "semantics": {
      "enum": [
        "linux-pid-directory-v1",
        "linux-start-ticks-v1",
        "darwin-ps-selection-v1",
        "darwin-lstart-utc-v1",
        "windows-cim-completed-v1",
        "windows-utc-v1"
      ]
    },
    "precision": {
      "enum": ["not-applicable", "one-tick", "one-second", "one-hundred-nanoseconds"]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidenceDigest", "reviewDigest"],
      "properties": {
        "status": {
          "const": "accepted"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "reviewDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
