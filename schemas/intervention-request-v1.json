{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-peer-review.intervention-request/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ai-peer-review.intervention-request/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "cancel"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": ["kind", "reason"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "resume"
            }
          },
          "required": ["kind"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "replace-participant"
            },
            "participant_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "candidate": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "selector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "effort": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": ["selector"]
            },
            "user_authorization": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": ["kind", "participant_id", "candidate", "user_authorization", "reason"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "extend-cap"
            },
            "requested_stage_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "max_rounds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "user_authorization": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": ["kind", "requested_stage_id", "max_rounds", "user_authorization", "reason"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reconcile-operation"
            },
            "operation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "evidence_receipts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "minItems": 1
            },
            "user_authorization": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": ["kind", "operation_id", "evidence_receipts", "user_authorization", "reason"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "resolve-checkpoint"
            },
            "checkpoint_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "expected_current_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "disposition": {
              "enum": ["retain-partial", "restore-sealed"]
            },
            "target_sealed_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "user_authorization": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "kind",
            "checkpoint_id",
            "expected_current_digest",
            "disposition",
            "user_authorization",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "acknowledge-unresolved"
            },
            "operation_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "user_authorization": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": ["kind", "operation_ids", "user_authorization", "reason"]
        }
      ]
    }
  },
  "required": ["schema", "run_id", "action_id", "expected_revision", "action"]
}
