{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-peer-review.event/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "review_id", "sequence", "revision", "type", "actor", "at", "payload"],
  "properties": {
    "schema": { "const": "ai-peer-review.event/v1" },
    "review_id": { "$ref": "#/$defs/id" },
    "sequence": { "$ref": "#/$defs/positive" },
    "revision": { "$ref": "#/$defs/nonNegative" },
    "type": { "type": "string" },
    "actor": { "anyOf": [{ "const": "system" }, { "$ref": "#/$defs/digest" }] },
    "at": { "$ref": "#/$defs/time" },
    "payload": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "type": { "const": "review-created" },
        "payload": { "$ref": "#/$defs/reviewCreated" }
      }
    },
    {
      "properties": {
        "type": { "const": "reviewer-joined" },
        "payload": { "$ref": "#/$defs/reviewerJoined" }
      }
    },
    {
      "properties": {
        "type": { "const": "reviewer-revisions-requested" },
        "payload": { "$ref": "#/$defs/reviewDecision" }
      }
    },
    {
      "properties": {
        "type": { "const": "reviewer-accepted" },
        "payload": { "$ref": "#/$defs/reviewDecision" }
      }
    },
    {
      "properties": {
        "type": { "const": "author-revision-committed" },
        "payload": { "$ref": "#/$defs/authorRevision" }
      }
    },
    {
      "properties": {
        "type": { "const": "author-closing-round-committed" },
        "payload": { "$ref": "#/$defs/authorClosing" }
      }
    },
    {
      "properties": {
        "type": { "const": "finalization-started" },
        "payload": { "$ref": "#/$defs/empty" }
      }
    },
    {
      "properties": {
        "type": { "const": "acceptance-committed" },
        "payload": { "$ref": "#/$defs/terminalCommittedPayload" }
      }
    },
    {
      "properties": {
        "type": { "const": "acceptance-sealed-no-commit" },
        "payload": { "$ref": "#/$defs/terminalUncommittedPayload" }
      }
    },
    {
      "properties": {
        "type": { "const": "intervention-entered" },
        "payload": { "$ref": "#/$defs/intervention" }
      }
    },
    {
      "properties": {
        "type": { "const": "continued-to-reviewer" },
        "payload": { "$ref": "#/$defs/continuation" }
      }
    },
    {
      "properties": {
        "type": { "const": "continued-to-author" },
        "payload": { "$ref": "#/$defs/continuation" }
      }
    },
    {
      "properties": {
        "type": { "const": "same-session-reclaim" },
        "payload": { "$ref": "#/$defs/reclaim" }
      }
    },
    {
      "properties": {
        "type": { "const": "participant-replaced" },
        "payload": { "$ref": "#/$defs/replacement" }
      }
    },
    {
      "properties": {
        "type": { "const": "override-committed" },
        "payload": { "$ref": "#/$defs/overrideCommitted" }
      }
    },
    {
      "properties": {
        "type": { "const": "override-sealed-no-commit" },
        "payload": { "$ref": "#/$defs/overrideUncommitted" }
      }
    },
    {
      "properties": {
        "type": { "const": "abandoned" },
        "payload": { "$ref": "#/$defs/abandonment" }
      }
    },
    {
      "properties": {
        "type": { "const": "turn-claimed" },
        "payload": { "$ref": "#/$defs/claimPayload" }
      }
    },
    {
      "properties": {
        "type": { "const": "identity-changed" },
        "payload": { "$ref": "#/$defs/identityChange" }
      }
    },
    {
      "properties": {
        "type": { "const": "challenge-requested" },
        "payload": { "$ref": "#/$defs/challengePayload" }
      }
    },
    {
      "properties": {
        "type": { "const": "challenge-superseded" },
        "payload": { "$ref": "#/$defs/challengeIdPayload" }
      }
    },
    {
      "properties": {
        "type": { "const": "supplement-registered" },
        "payload": { "$ref": "#/$defs/supplementPayload" }
      }
    },
    {
      "properties": {
        "type": { "const": "delivery-written" },
        "payload": { "$ref": "#/$defs/deliveryPayload" }
      }
    },
    {
      "properties": {
        "type": { "const": "delivery-acknowledged" },
        "payload": { "$ref": "#/$defs/deliveryIdPayload" }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "time": { "type": "string", "format": "date-time" },
    "positive": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "nonNegative": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "role": { "enum": ["author", "reviewer"] },
    "host": { "enum": ["codex", "claude-code", "grok", "other"] },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "host",
        "provider",
        "model_id",
        "model_display",
        "session_fingerprint",
        "identity_source",
        "joined_at"
      ],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "host": { "$ref": "#/$defs/host" },
        "provider": { "enum": ["openai", "anthropic", "xai", "other"] },
        "model_id": { "type": "string", "minLength": 1 },
        "model_display": { "type": "string", "minLength": 1 },
        "session_fingerprint": { "$ref": "#/$defs/digest" },
        "identity_source": { "enum": ["runtime", "declared"] },
        "joined_at": { "$ref": "#/$defs/time" }
      }
    },
    "initialArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "head", "blob", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "head": { "$ref": "#/$defs/gitObject" },
        "blob": { "$ref": "#/$defs/gitObject" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blob", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "blob": { "$ref": "#/$defs/gitObject" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "role",
        "session_fingerprint",
        "host",
        "claimed_at",
        "last_activity_at",
        "expires_at",
        "pid"
      ],
      "properties": {
        "claim_id": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/role" },
        "session_fingerprint": { "$ref": "#/$defs/digest" },
        "host": { "$ref": "#/$defs/host" },
        "claimed_at": { "$ref": "#/$defs/time" },
        "last_activity_at": { "$ref": "#/$defs/time" },
        "expires_at": { "$ref": "#/$defs/time" },
        "pid": { "$ref": "#/$defs/positive" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "strength",
        "signer_id",
        "signer_fingerprint",
        "challenge_digest",
        "verified_at"
      ],
      "properties": {
        "source": { "enum": ["detached-signature", "host-approval", "test-fixture"] },
        "strength": {
          "enum": [
            "cryptographic-external",
            "hardware-presence",
            "host-verified",
            "cryptographic-local",
            "unverified-test"
          ]
        },
        "signer_id": { "type": "string", "minLength": 1 },
        "signer_fingerprint": { "type": "string", "minLength": 1 },
        "challenge_digest": { "$ref": "#/$defs/digest" },
        "verified_at": { "$ref": "#/$defs/time" }
      }
    },
    "terminalCommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "manifest_digest"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitObject" },
        "manifest_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "terminalUncommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_digest", "manifest_digest"],
      "properties": {
        "snapshot_digest": { "$ref": "#/$defs/digest" },
        "manifest_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "challenge_id",
        "review_id",
        "intervention_id",
        "protocol_revision",
        "action",
        "parameters_digest",
        "nonce",
        "expires_at"
      ],
      "properties": {
        "schema": { "const": "ai-peer-review.grant-challenge/v1" },
        "challenge_id": { "$ref": "#/$defs/id" },
        "review_id": { "$ref": "#/$defs/id" },
        "intervention_id": { "$ref": "#/$defs/id" },
        "protocol_revision": { "$ref": "#/$defs/nonNegative" },
        "action": {
          "enum": [
            "pin-verifier",
            "continue",
            "supplement",
            "accept-over-objections",
            "replace-participant"
          ]
        },
        "parameters_digest": { "$ref": "#/$defs/digest" },
        "nonce": { "$ref": "#/$defs/id" },
        "expires_at": { "$ref": "#/$defs/time" }
      }
    },
    "supplement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplement_id",
        "digest",
        "target_role",
        "target_turn",
        "content_retention",
        "attestation"
      ],
      "properties": {
        "supplement_id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/digest" },
        "target_role": { "$ref": "#/$defs/role" },
        "target_turn": { "$ref": "#/$defs/positive" },
        "content_retention": { "const": "scratch-only" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_id", "recipient", "digest"],
      "properties": {
        "delivery_id": { "$ref": "#/$defs/id" },
        "recipient": { "$ref": "#/$defs/role" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "reviewCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_mode", "max_turns", "artifact", "author"],
      "properties": {
        "commit_mode": { "enum": ["normal", "no-commit"] },
        "max_turns": { "$ref": "#/$defs/positive" },
        "artifact": { "$ref": "#/$defs/initialArtifact" },
        "author": { "$ref": "#/$defs/participant" }
      }
    },
    "reviewerJoined": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer"],
      "properties": { "reviewer": { "$ref": "#/$defs/participant" } }
    },
    "reviewDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "response", "finding_ids"],
      "properties": {
        "turn": { "$ref": "#/$defs/positive" },
        "response": { "$ref": "#/$defs/response" },
        "finding_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "authorRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "response", "artifact", "commit"],
      "properties": {
        "turn": { "$ref": "#/$defs/positive" },
        "response": { "$ref": "#/$defs/response" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "commit": { "$ref": "#/$defs/gitObject" }
      }
    },
    "authorClosing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn",
        "response",
        "artifact",
        "commit",
        "intervention_id",
        "reason",
        "interrupted_state"
      ],
      "properties": {
        "turn": { "$ref": "#/$defs/positive" },
        "response": { "$ref": "#/$defs/response" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "commit": { "$ref": "#/$defs/gitObject" },
        "intervention_id": { "$ref": "#/$defs/id" },
        "reason": { "const": "turn-budget-exhausted" },
        "interrupted_state": { "const": "reviewer-turn" }
      }
    },
    "empty": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "terminalCommittedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal"],
      "properties": { "terminal": { "$ref": "#/$defs/terminalCommitted" } }
    },
    "terminalUncommittedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal"],
      "properties": { "terminal": { "$ref": "#/$defs/terminalUncommitted" } }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "reason", "interrupted_state"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/id" },
        "reason": { "enum": ["turn-budget-exhausted", "stale-claim", "participant-loss"] },
        "interrupted_state": { "enum": ["reviewer-turn", "author-revision"] }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "additional_turns", "effective_max_turns", "attestation"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/id" },
        "additional_turns": { "$ref": "#/$defs/positive" },
        "effective_max_turns": { "$ref": "#/$defs/positive" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "reclaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "old_claim", "new_claim"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/id" },
        "old_claim": { "$ref": "#/$defs/claim" },
        "new_claim": { "$ref": "#/$defs/claim" }
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intervention_id",
        "role",
        "outgoing_claim",
        "incoming_participant",
        "attestation"
      ],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/role" },
        "outgoing_claim": { "$ref": "#/$defs/claim" },
        "incoming_participant": { "$ref": "#/$defs/participant" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "overrideCommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "terminal", "attestation"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/id" },
        "terminal": { "$ref": "#/$defs/terminalCommitted" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "overrideUncommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "terminal", "attestation"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/id" },
        "terminal": { "$ref": "#/$defs/terminalUncommitted" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "abandonment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "reason", "retained_paths"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1 },
        "retained_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "claimPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim"],
      "properties": { "claim": { "$ref": "#/$defs/claim" } }
    },
    "identityChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "identity"],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "identity": { "$ref": "#/$defs/participant" }
      }
    },
    "challengePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge"],
      "properties": { "challenge": { "$ref": "#/$defs/challenge" } }
    },
    "challengeIdPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge_id"],
      "properties": { "challenge_id": { "$ref": "#/$defs/id" } }
    },
    "supplementPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplement"],
      "properties": { "supplement": { "$ref": "#/$defs/supplement" } }
    },
    "deliveryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery"],
      "properties": { "delivery": { "$ref": "#/$defs/delivery" } }
    },
    "deliveryIdPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_id"],
      "properties": { "delivery_id": { "$ref": "#/$defs/id" } }
    }
  }
}
