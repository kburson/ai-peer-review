{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-peer-review.protocol/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_id",
    "sequence",
    "revision",
    "state",
    "current_actor",
    "commit_mode",
    "max_turns",
    "claim_ttl_ms",
    "authority",
    "turns_used",
    "artifact",
    "claims",
    "challenges",
    "supplements",
    "deliveries",
    "intervention",
    "terminal_evidence",
    "next_action"
  ],
  "properties": {
    "schema": { "const": "ai-peer-review.protocol/v1" },
    "review_id": { "type": ["string", "null"] },
    "sequence": { "type": "integer", "minimum": 0 },
    "revision": { "type": "integer", "minimum": 0 },
    "state": { "type": ["string", "null"] },
    "current_actor": { "type": ["string", "null"] },
    "commit_mode": { "type": ["string", "null"] },
    "max_turns": { "type": "integer", "minimum": 0 },
    "claim_ttl_ms": { "type": "integer", "minimum": 0 },
    "authority": { "type": ["object", "null"] },
    "turns_used": { "type": "integer", "minimum": 0 },
    "artifact": { "type": ["object", "null"] },
    "claims": { "type": "object" },
    "challenges": { "type": "array" },
    "supplements": { "type": "array" },
    "deliveries": { "type": "array" },
    "intervention": { "type": ["object", "null"] },
    "terminal_evidence": { "type": ["object", "null"] },
    "next_action": { "type": ["string", "null"] }
  }
}
