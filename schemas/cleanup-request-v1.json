{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-peer-review.cleanup-request/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ai-peer-review.cleanup-request/v1"
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "mode": {
      "enum": ["dry-run", "apply"]
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": ["schema", "project", "mode"],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "apply"
          }
        }
      },
      "then": {
        "required": ["action_id"]
      }
    }
  ]
}
