  "$defs": {
    "gitRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "path", "blob", "sha256"],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!(test|tests|node_modules|\\.scratch)/)[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
        },
        "blob": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "normalReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "subject", "manifest", "finalResponse", "finalization"],
      "properties": {
        "reviewId": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "$ref": "#/$defs/gitRef"
        },
        "manifest": {
          "$ref": "#/$defs/gitRef"
        },
        "finalResponse": {
          "$ref": "#/$defs/gitRef"
        },
        "finalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "sha256"],
          "properties": {
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review", "receipt", "verifier"],
      "properties": {
        "review": {
          "$ref": "#/$defs/normalReview"
        },
        "receipt": {
          "$ref": "#/$defs/gitRef"
        },
        "verifier": {
          "$ref": "#/$defs/gitRef"
        }
      }
    }
  }
}
